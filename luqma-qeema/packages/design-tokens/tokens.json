{
  "$meta": {
    "name": "luqma-qeema design tokens",
    "version": "1.0.0",
    "source": "brand/colors/color-palette.json (approved 2026-11-20) and brand/DESIGN_SYSTEM.md",
    "rule": "The only source of colors, type, spacing, radii and shadows for every app. Do not define these values anywhere else (BRAND_DIRECTIVE §12)."
  },
  "color": {
    "brand": {
      "emerald": "#084828", "emerald-dark": "#05301B", "emerald-active": "#0F5A34", "emerald-soft": "#E3F0E8",
      "gold": "#F0B028", "gold-text": "#8A5A00", "gold-soft": "#FBEBC4",
      "ivory": "#FCF8EC", "ivory-deep": "#F2EAD6",
      "orange": "#F07810", "orange-text": "#B04A00", "orange-soft": "#FFF4EA"
    },
    "neutral": {
      "surface": "#FFFFFF", "background": "#FCF8EC", "border": "#EAE3D2", "table-head": "#F6F1E3",
      "ink": "#1D2A24", "ink-muted": "#5B6B63", "on-brand": "#FFFFFF"
    },
    "functional": {
      "success": "#1E7A44", "success-soft": "#E3F0E8",
      "warning": "#8A5A00", "warning-soft": "#FBEBC4",
      "error": "#B42318", "error-soft": "#FDECEA",
      "info": "#1F4E9E", "info-soft": "#E8EEF9"
    },
    "order-status": {
      "received":        {"fg": "#1F4E9E", "bg": "#E8EEF9"},
      "awaiting":        {"fg": "#1F4E9E", "bg": "#E8EEF9"},
      "confirmed":       {"fg": "#084828", "bg": "#E3F0E8"},
      "preparing":       {"fg": "#8A5A00", "bg": "#FBEBC4"},
      "ready":           {"fg": "#FFFFFF", "bg": "#084828"},
      "courier-assigned":{"fg": "#084828", "bg": "#E3F0E8"},
      "picked-up":       {"fg": "#084828", "bg": "#E3F0E8"},
      "on-the-way":      {"fg": "#084828", "bg": "#E3F0E8"},
      "delivered":       {"fg": "#FFFFFF", "bg": "#1E7A44"},
      "failed":          {"fg": "#FFFFFF", "bg": "#B42318"},
      "cancelled":       {"fg": "#5B6B63", "bg": "#EFEDE7"},
      "late":            {"fg": "#FFFFFF", "bg": "#B04A00"}
    },
    "chart": ["#084828", "#F0B028", "#F07810", "#1F4E9E", "#78B030", "#8A5A00"]
  },
  "font": {
    "family": {
      "arabic": "'IBM Plex Sans Arabic', 'IBM Plex Sans', system-ui, sans-serif",
      "latin": "'IBM Plex Sans', 'IBM Plex Sans Arabic', system-ui, sans-serif"
    },
    "weight": {"regular": 400, "medium": 500, "bold": 700},
    "size": {"xs": 12, "sm": 13, "md": 14, "base": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36},
    "line-height": {"tight": 1.3, "normal": 1.6}
  },
  "space": {"1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64},
  "radius": {"sm": 8, "md": 12, "lg": 16, "xl": 22, "pill": 999},
  "shadow": {
    "sm": "0 1px 2px rgba(29,42,36,0.08)",
    "md": "0 6px 16px rgba(29,42,36,0.10)",
    "lg": "0 18px 30px rgba(8,72,40,0.18)"
  },
  "size": {
    "touch-min": 44, "button": 52, "button-sm": 44, "input": 48,
    "header-mobile": 56, "header-web": 64, "sidebar": 240,
    "table-row": 48, "icon": 24, "icon-sm": 20, "icon-stroke": 2,
    "modal-sm": 480, "modal-md": 640, "modal-lg": 880,
    "logo-min-full": 160, "logo-wordmark-header-mobile": 34, "logo-wordmark-header-web": 40
  }
}
